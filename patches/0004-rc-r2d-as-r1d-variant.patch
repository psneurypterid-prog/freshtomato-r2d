+/* Xiaomi R2D: the stock firmware keeps a hidden, unencrypted provisioning AP "miwifi_ready" (wl1.3) in the
+ * shared nvram, and the stock fallback (os1) recreates it. Drop every wlX.Y_* key whose set has SSID miwifi_ready. */
+static void r2d_drop_miwifi_ready(void)
+{
+	char *buf, *name, *eq, prefix[16], key[32];
+	int u, v, n, dropped = 0;
+
+	for (u = 0; u <= 1; u++) {
+		for (v = 1; v <= 3; v++) {
+			snprintf(prefix, sizeof(prefix), "wl%d.%d_", u, v);
+			snprintf(key, sizeof(key), "%sssid", prefix);
+			if (!nvram_match(key, "miwifi_ready"))
+				continue;
+			if (!(buf = malloc(MAX_NVRAM_SPACE)))
+				return;
+			nvram_getall(buf, MAX_NVRAM_SPACE);
+			n = strlen(prefix);
+			/* the buffer is a private copy: cut "key=value" to "key" in place, then unset */
+			for (name = buf; *name; name += strlen(name) + 1) {
+				if (strncmp(name, prefix, n) != 0)
+					continue;
+				if ((eq = strchr(name, '=')) != NULL) {
+					*eq = 0;
+					nvram_unset(name);
+					dropped++;
+					*eq = '=';	/* restore so the walk continues over the full entry */
+				}
+			}
+			free(buf);
+			syslog(LOG_INFO, "R2D: removed Xiaomi provisioning AP %s* (miwifi_ready)", prefix);
+		}
+	}
+	if (dropped)
+		nvram_commit();
+}
