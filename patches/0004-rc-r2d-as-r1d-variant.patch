+/* Xiaomi R2D: Wi-Fi encryption and key are inherited from the stock nvram (wlN_akm/_crypto/_wpa_psk), but the
+ * web UI shows wlN_security_mode, which the stock firmware does not set. Derive it once on the first boot so the
+ * UI tells the truth - otherwise saving the Wireless page unchanged would turn the network into an open one. */
+static void r2d_sync_wl_security(void)
+{
+	char akm[64], name[32], *w, *save;
+	const char *mode;
+	int u, psk, psk2;
+
+	for (u = 0; u <= 1; u++) {
+		snprintf(name, sizeof(name), "wl%d_akm", u);
+		strlcpy(akm, nvram_safe_get(name), sizeof(akm));
+		psk = psk2 = 0;
+		for (w = strtok_r(akm, " ", &save); w; w = strtok_r(NULL, " ", &save)) {
+			if (!strcmp(w, "psk"))
+				psk = 1;
+			else if (!strcmp(w, "psk2"))
+				psk2 = 1;
+		}
+		snprintf(name, sizeof(name), "wl%d_wpa_psk", u);
+		if ((psk || psk2) && strlen(nvram_safe_get(name)) >= 8)
+			mode = (psk && psk2) ? "wpaX_personal" : (psk2 ? "wpa2_personal" : "wpa_personal");
+		else {
+			mode = "disabled";
+			snprintf(name, sizeof(name), "wl%d_akm", u);
+			nvram_set(name, "");
+		}
+		snprintf(name, sizeof(name), "wl%d_security_mode", u);
+		nvram_set(name, mode);
+		snprintf(name, sizeof(name), "wl%d_auth_mode", u);
+		nvram_set(name, "none");
+	}
+}
