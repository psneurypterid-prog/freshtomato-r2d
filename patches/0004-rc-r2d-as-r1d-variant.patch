+/* Xiaomi R2D: the internal SATA disk (ahci) is probed before userspace exists, so its block uevents
+ * never reach the hotplug handler. Replay "add" for its partitions once rc is ready. */
+static void r2d_coldplug_sata(void)
+{
+	DIR *bd, *pd;
+	struct dirent *be, *pe;
+	char lnk[256], pth[160], pn[16], *h;
+	int n;
+
+	if ((bd = opendir("/sys/block")) == NULL)
+		return;
+	while ((be = readdir(bd)) != NULL) {
+		if (strncmp(be->d_name, "sd", 2) != 0)
+			continue;
+		snprintf(pth, sizeof(pth), "/sys/block/%s/device", be->d_name);
+		if ((n = readlink(pth, lnk, sizeof(lnk) - 1)) <= 0)
+			continue;
+		lnk[n] = 0;
+		if ((h = strstr(lnk, "/host")) == NULL)
+			continue;
+		snprintf(pth, sizeof(pth), "/sys/class/scsi_host/host%d/proc_name", atoi(h + 5));
+		if (f_read_string(pth, pn, sizeof(pn)) <= 0 || strncmp(pn, "ahci", 4) != 0)
+			continue;
+		snprintf(pth, sizeof(pth), "/sys/block/%s", be->d_name);
+		if ((pd = opendir(pth)) == NULL)
+			continue;
+		while ((pe = readdir(pd)) != NULL) {
+			if (strncmp(pe->d_name, be->d_name, strlen(be->d_name)) != 0)
+				continue;
+			snprintf(pth, sizeof(pth), "/sys/block/%s/%s/uevent", be->d_name, pe->d_name);
+			f_write_string(pth, "add", 0, 0);
+		}
+		closedir(pd);
+	}
+	closedir(bd);
+}
